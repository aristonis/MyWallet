<?xml version="1.0" encoding="utf-8"?>
<!--
    A closed ledger with a mint ribbon bookmark tucked into its top edge: the book is shut and your
    place is kept. The cover is one solid shape with a hinge groove cut out of it, and the ribbon sits
    in its own notch with a real gap all round, so it survives as a separate shape in the monochrome
    layer too.

    Everything sits inside the adaptive-icon safe zone (the central 66dp of the 108dp canvas), so no
    launcher mask can clip it. The cover is solid rather than outlined so it still reads at 16px.
    The groove is a hole, hence evenOdd.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Ledger cover with the ribbon notch and the hinge groove -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M38,32 H51 V61.24 L59,53.24 L67,61.24 V32 H70 A6,6 0 0 1 76,38 V70 A6,6 0 0 1 70,76 H38 A6,6 0 0 1 32,70 V38 A6,6 0 0 1 38,32 Z M43.5,40.5 V67.5 A2.5,2.5 0 0 1 38.5,67.5 V40.5 A2.5,2.5 0 0 1 43.5,40.5 Z" />
    <!-- Ribbon bookmark -->
    <path
        android:fillColor="#82F5F7"
        android:pathData="M54,26 H64 V54 L59,49 L54,54 Z" />
</vector>

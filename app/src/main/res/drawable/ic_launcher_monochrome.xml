<?xml version="1.0" encoding="utf-8"?>
<!--
    The same wallet mark for Android themed icons. One colour throughout — the system recolours this
    layer to match the user's wallpaper, so the mint dot has to become part of the outline here
    instead of an accent that would silently vanish.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M34,36 L74,36 A8,8 0 0 1 82,44 L82,66 A8,8 0 0 1 74,74 L34,74 A8,8 0 0 1 26,66 L26,44 A8,8 0 0 1 34,36 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M38,55 L56,55"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M65.5,55 a4.5,4.5 0 1 0 9,0 a4.5,4.5 0 1 0 -9,0 Z"
        android:fillColor="#FFFFFF" />
</vector>
